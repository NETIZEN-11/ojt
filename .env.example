# Agent Red-Teaming & Evaluation Framework - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Agent Red-Teaming Framework"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="your-secret-key-min-32-chars-change-in-production"
API_V1_PREFIX="/api/v1"

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/redteam"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL="redis://localhost:6379/0"
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# CELERY / TASK QUEUE
# =============================================================================
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
CELERY_TASK_SERIALIZER="json"
CELERY_RESULT_SERIALIZER="json"
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE="UTC"
CELERY_ENABLE_UTC=true
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=1800
CELERY_WORKER_PREFETCH_MULTIPLIER=4

# =============================================================================
# LLM PROVIDERS
# =============================================================================
# Primary judge model (used for evaluation)
PRIMARY_JUDGE_PROVIDER="openai"
PRIMARY_JUDGE_MODEL="gpt-4o-2024-08-06"
PRIMARY_JUDGE_API_KEY=""
PRIMARY_JUDGE_BASE_URL=""

# Secondary/fallback judge model
SECONDARY_JUDGE_PROVIDER="anthropic"
SECONDARY_JUDGE_MODEL="claude-3-5-sonnet-20241022"
SECONDARY_JUDGE_API_KEY=""
SECONDARY_JUDGE_BASE_URL=""

# Generator model (for adversarial test generation)
GENERATOR_PROVIDER="openai"
GENERATOR_MODEL="gpt-4o-2024-08-06"
GENERATOR_API_KEY=""
GENERATOR_BASE_URL=""

# Planner model (for red-team agent)
PLANNER_PROVIDER="openai"
PLANNER_MODEL="gpt-4o-2024-08-06"
PLANNER_API_KEY=""
PLANNER_BASE_URL=""

# Embedding model (for RAG, novelty filtering)
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-large"
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""

# Evaluation mode: "local" (mock/deterministic) or "production" (real providers)
EVAL_MODE="local"

# =============================================================================
# TARGET AGENT
# =============================================================================
TARGET_AGENT_DEFAULT_TIMEOUT=30
TARGET_AGENT_MAX_RETRIES=3
TARGET_AGENT_ALLOWED_HOSTS=""  # Comma-separated, empty = allow all (dev only)
TARGET_AGENT_BLOCK_PRIVATE_IPS=true

# =============================================================================
# VECTOR STORE (ChromaDB)
# =============================================================================
CHROMA_HOST="localhost"
CHROMA_PORT=8000
CHROMA_COLLECTION_PREFIX="redteam"

# =============================================================================
# OBJECT STORAGE (S3-compatible)
# =============================================================================
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="redteam-artifacts"
S3_REGION="us-east-1"

# =============================================================================
# SECURITY / AUTH
# =============================================================================
JWT_ALGORITHM="RS256"
JWT_PRIVATE_KEY_PATH=""  # Path to RSA private key
JWT_PUBLIC_KEY_PATH=""   # Path to RSA public key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OIDC (optional)
OIDC_ISSUER_URL=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_SCOPES="openid,profile,email"

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
CORS_ALLOW_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# EVALUATION SETTINGS
# =============================================================================
# Judge settings
JUDGE_TEMPERATURE=0.0
JUDGE_MAX_TOKENS=2048
JUDGE_CONFIDENCE_THRESHOLD=0.7
JUDGE_DOUBLE_SCORE=true
JUDGE_RETRY_ON_SCHEMA_ERROR=true

# Matcher settings
EXACT_MATCH_CASE_SENSITIVE=false
REGEX_MATCH_TIMEOUT_MS=1000

# Regression detection
REGRESSION_DETECTION_ENABLED=true
SEVERITY_CRITICAL_OVERRIDE=true

# CI Gate
GATE_CRITICAL_ACTION="block"
GATE_HIGH_ACTION="block"
GATE_MEDIUM_ACTION="warn"
GATE_LOW_ACTION="warn"
GATE_INCONCLUSIVE_ACTION="fail"
GATE_INFRA_FAILURE_ACTION="fail"

# Adversarial generation
ADVERSARIAL_GENERATION_ENABLED=true
ADVERSARIAL_NOVELTY_THRESHOLD=0.75
ADVERSARIAL_BATCH_SIZE=10
ADVERSARIAL_MAX_RETRIES=3

# Red-team agent
REDTEAM_MAX_TURNS=8
REDTEAM_TURN_TIMEOUT_SECONDS=30

# Cost controls
COST_PER_RUN_LIMIT_USD=5.0
COST_DAILY_LIMIT_USD=100.0
COST_TRACKING_ENABLED=true

# =============================================================================
# OBSERVABILITY
# =============================================================================
LOG_LEVEL="INFO"
LOG_FORMAT="json"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_SERVICE_NAME="redteam-framework"
OTEL_TRACES_SAMPLER="parentbased_always_on"
OTEL_METRICS_EXPORT_INTERVAL_MS=60000

# Prometheus
PROMETHEUS_METRICS_PORT=9090

# Alerting (webhook URLs)
ALERT_WEBHOOK_URL=""
ALERT_CRITICAL_WEBHOOK_URL=""

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_ADVERSARIAL_GENERATOR=true
FEATURE_REDTEAM_AGENT=true
FEATURE_SECONDARY_JUDGE=true
FEATURE_RAG_RETRIEVAL=true
FEATURE_STREAMING_RESPONSES=false
FEATURE_EXPERIMENTAL_UI=false

# =============================================================================
# DATA RETENTION
# =============================================================================
TRANSCRIPT_RETENTION_DAYS=365
CRITICAL_FINDINGS_RETENTION_DAYS=0  # 0 = indefinite
REPORT_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================
DEV_SEED_DATA=true
DEV_MOCK_TARGET_AGENT=true
DEV_MOCK_JUDGE=true